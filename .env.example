# Neon Postgres connection string (pooled)
DATABASE_URL=

# Better Auth — secret used to sign sessions, and the canonical server origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Public origin of the app, exposed to the browser
NEXT_PUBLIC_APP_URL=

# Practice name shown in the sidebar header. Defaults to "DentaFlow" if unset.
NEXT_PUBLIC_CLINIC_NAME=

# Email of the first admin staff member, created by `npm run bootstrap:admin`
BOOTSTRAP_ADMIN_EMAIL=
